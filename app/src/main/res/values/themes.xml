<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Shoprime" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/primary_dark_blue</item>
        <item name="colorPrimaryContainer">@color/secondary_dark_blue</item>
        <item name="colorOnPrimaryContainer">@color/gold_light</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="android:windowBackground">@color/primary_dark_blue</item>
        <item name="android:statusBarColor">@color/primary_dark_blue</item>
        <item name="android:navigationBarColor">@color/primary_dark_blue</item>
    </style>

    <style name="Theme.Shoprime" parent="Base.Theme.Shoprime" />

    <!-- Estilo para TextInputLayout llamativo -->
    <style name="Shoprime.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/gold</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/gold</item>
        <item name="android:textColorHint">@color/gold_light</item>
    </style>

    <!-- Estilo para Botones llamativos -->
    <style name="Shoprime.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/primary_dark_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>